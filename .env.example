# ==============================================================================
# GTA 6 PLAYER HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure actual secrets.
# NEVER commit .env to source control.

# --- APPLICATION & RUNTIME ---
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=generate_a_secure_random_string_here_min_32_chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DATABASE (POSTGRESQL + PGVECTOR) ---
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gta6playerhub
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/gta6playerhub

# --- SUPABASE INTEGRATION (AUTH & STORAGE) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- CACHE & BACKGROUND WORKERS (REDIS + CELERY) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI GAMING PROBLEM SOLVER (GOOGLE GEMINI API) ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- EXTERNAL DATA FEEDS & PRICE TRACKING ---
EXCHANGE_RATE_API_KEY=your_free_currency_api_key
PSN_STORE_API_BASE=https://store.playstation.com/api
XBOX_STORE_API_BASE=https://displaycatalog.mp.microsoft.com/v7.0/products

# --- SECURITY & RATE LIMITING ---
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=15/minute

# --- SENTRY ERROR MONITORING (OPTIONAL IN DEV) ---
SENTRY_DSN=
