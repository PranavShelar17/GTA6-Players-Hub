# GTA 6 Player Hub Backend Configuration
APP_NAME="GTA 6 Player Hub API"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY="development_secret_key_minimum_32_characters_long_for_security"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:54322/postgres"

# Redis & Celery Message Broker Configuration (Phase 10)
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/1"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/2"

# Automation API & Cron Key
AUTOMATION_API_KEY="vice_city_automation_secret_key_change_in_production"

# Configurable Automation Task Schedules (Minutes / Hours)
NEWS_COLLECTION_INTERVAL_MINUTES=30
PRICE_REFRESH_INTERVAL_MINUTES=120
EVENT_REFRESH_INTERVAL_HOURS=6
EVENT_REMINDER_INTERVAL_MINUTES=1
NOTIFICATION_RETRY_INTERVAL_MINUTES=5
SOURCE_HEALTH_CHECK_INTERVAL_HOURS=24
DATA_FRESHNESS_CHECK_INTERVAL_HOURS=24

# Email Notification Delivery Service (Phase 10)
EMAIL_ENABLED=False
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-sendgrid-api-key"
SMTP_FROM_EMAIL="notifications@gta6playerhub.com"
SMTP_FROM_NAME="GTA 6 Player Hub"

# Web Push Notification Delivery Service (VAPID) (Phase 10)
PUSH_ENABLED=False
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@gta6playerhub.com"
